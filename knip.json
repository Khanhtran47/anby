{
	"$schema": "https://unpkg.com/knip@5/schema.json",
	"eslint": true,
	"github-action": true,
	"ignore": [
		"eslint.config.mjs",
		"package.json",
		"postcss",
		"postcss.config.mjs",
		"i18n/**/*",
		".storybook/vite.config.mts",
		"services/**/*",
		"components/**/*.tsx",
		"utils/**/*.{tsx,ts}"
	],
	"lefthook": true,
	"next": true,
	"prettier": true,
	"project": ["**/*.{js,cjs,mjs,jsx,ts,cts,mts,tsx}"]
}
