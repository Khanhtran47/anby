    "@commitlint/types": "^19.8.1",
    "@eslint/eslintrc": "3.3.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.4.1",
    "@khanhtran47/config": "1.0.7",
    "@next/eslint-plugin-next": "15.3.2",
